flowchart TB
    subgraph row1["Legacy owns writes"]
        direction LR
        A["Stage 1<br/>Legacy writes<br/>New: CDC read copy"]
        B["Stage 2<br/>Legacy writes<br/>New: shadow compute"]
        A -->|"gate: read model reconciles<br/>over N business days,<br/>month-end included"| B
    end
    subgraph row2["New side owns writes"]
        direction LR
        C["Stage 3<br/>New writes<br/>Legacy: reverse-sync copy<br/><i>rollback needs data<br/>flowing back to legacy</i>"]
        D["Stage 4<br/>Legacy consumers moved<br/>Sync and legacy path retired"]
        C -->|"gate: batch, reports and<br/>regulatory feeds migrated"| D
    end
    row1 -->|"gate: mismatches explained,<br/>signed off, rollback tested"| row2
    classDef legacy fill:#e8eef7,stroke:#3b5b8c,color:#1b2a40
    classDef modern fill:#e6f4ea,stroke:#2e7d4f,color:#123b22
    class A,B legacy
    class C,D modern
    style row1 fill:#fafbfd,stroke:#3b5b8c
    style row2 fill:#f7fbf8,stroke:#2e7d4f
