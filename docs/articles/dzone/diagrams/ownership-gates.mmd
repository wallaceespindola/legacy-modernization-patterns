flowchart BT
    subgraph R1[" "]
        direction LR
        S1["Stage 1<br/>Writer: legacy<br/>New: CDC read copy"] -->|"gate: read model<br/>reconciles"| S2["Stage 2<br/>Writer: legacy<br/>New: computes in shadow,<br/>reconciled daily"]
    end
    subgraph R2[" "]
        direction LR
        S3["Stage 3<br/>Writer: new service<br/>Legacy: reverse-sync copy"] -->|"gate: batch, reports and<br/>regulatory feeds migrated"| S4["Stage 4<br/>Writer: new service<br/>Reverse sync and<br/>legacy path retired"]
    end
    R2 -.->|"rollback 3 to 2: ownership back to legacy, data flows back"| R1
    R1 -->|"gate 2 to 3: shadow clean, reverse sync tested, risk sign-off"| R2

    classDef legacy fill:#e0e7ff,stroke:#4338ca,color:#0f172a
    classDef modern fill:#dcfce7,stroke:#15803d,color:#0f172a
    class S1,S2 legacy
    class S3,S4 modern
    style R1 fill:#ffffff,stroke:#ffffff
    style R2 fill:#ffffff,stroke:#ffffff
